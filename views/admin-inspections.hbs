<main class="admin-shell">
    <section class="admin-hero">
        <div>
            <span class="admin-kicker">Inspection process</span>
            <h1>Inspections</h1>
            <p>Review client inspection requests, update house condition notes and monitor how many projects enter each month.</p>
        </div>
        <a class="admin-hero-action" href="/admin/projects">
            <i class="fa-solid fa-file-signature"></i>
            Create project
        </a>
    </section>

    <section class="metric-grid">
        <article class="metric-card">
            <span>Total inspections</span>
            <strong>{{inspectionStats.total}}</strong>
        </article>
        <article class="metric-card">
            <span>Pending project</span>
            <strong>{{inspectionStats.pending}}</strong>
        </article>
        <article class="metric-card">
            <span>Converted</span>
            <strong>{{inspectionStats.converted}}</strong>
        </article>
        <article class="metric-card">
            <span>Estimated total</span>
            <strong>{{money inspectionStats.estimatedTotal}}</strong>
        </article>
    </section>

    <section class="process-panel chart-panel">
        <div class="list-header">
            <div>
                <h2>projects by month</h2>
                <p>Projects created from inspections, grouped by month for each year.</p>
            </div>
            <select class="chart-year-select" aria-label="Select chart year"></select>
        </div>
        <canvas id="projects-month-chart" height="150" data-chart='{{{json projectChart}}}'></canvas>
    </section>

    <section class="process-grid">
        <form class="process-panel process-form" data-inspection-form>
            <div class="panel-heading">
                <span><i class="fa-solid fa-pen-to-square"></i></span>
                <div>
                    <h2>inspection update</h2>
                    <p>Select a row and update the admin review fields.</p>
                </div>
            </div>

            <label>code</label>
            <input name="id_inspeccion" type="text" readonly required placeholder="Select from list">

            <label>house condition</label>
            <input name="condicion_general" type="text" required>

            <label>estimated cost</label>
            <input name="costo_estimado" type="number" min="0" step="0.01">

            <label>notes</label>
            <textarea name="notas" rows="7"></textarea>

            <p class="process-message" aria-live="polite"></p>

            <div class="process-actions">
                <button class="light-btn" type="reset"><i class="fa-solid fa-plus"></i> new</button>
                <button class="save-btn" type="submit"><i class="fa-regular fa-floppy-disk"></i> save</button>
                <a class="light-btn danger-link" href="/admin"><i class="fa-solid fa-ban"></i> cancel</a>
            </div>
        </form>

        <section class="process-panel process-list">
            <div class="list-header">
                <div>
                    <h2>inspection list</h2>
                    <p>Client requests and conversion status.</p>
                </div>
                <div class="search-box">
                    <label>Search</label>
                    <input class="table-search" type="search" data-table="#inspections-table" placeholder="client, status, city">
                </div>
            </div>

            <div class="table-wrap">
                <table id="inspections-table">
                    <thead>
                        <tr>
                            <th>code</th>
                            <th>client</th>
                            <th>date</th>
                            <th>condition</th>
                            <th>estimate</th>
                            <th>address</th>
                            <th>status</th>
                            <th>action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each inspections}}
                            <tr
                                data-id="{{id_inspeccion}}"
                                data-condition="{{condicion_general}}"
                                data-cost="{{costo_estimado}}"
                                data-notes="{{notas}}"
                            >
                                <td>#{{id_inspeccion}}</td>
                                <td>
                                    <strong>{{cliente}}</strong>
                                    <span>{{email}}</span>
                                </td>
                                <td>{{formatDate fecha}}</td>
                                <td>{{condicion_general}}</td>
                                <td>{{money costo_estimado}}</td>
                                <td>{{num_casa}} {{calle}}, {{ciudad}} {{estado}} {{codigo_postal}}</td>
                                <td>
                                    {{#if id_proyecto}}
                                        <span class="status-pill status-completado">project #{{id_proyecto}}</span>
                                    {{else}}
                                        <span class="status-pill status-pending">pending</span>
                                    {{/if}}
                                </td>
                                <td>
                                    <button class="row-edit" type="button"><i class="fa-solid fa-pen"></i> edit</button>
                                </td>
                            </tr>
                        {{else}}
                            <tr>
                                <td colspan="8" class="empty-row">No inspections registered yet.</td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <button class="print-btn" type="button"><i class="fa-solid fa-print"></i> print</button>
        </section>
    </section>
</main>
