<main class="service-page electrical-theme">
    <section class="service-hero">
        <div class="service-hero__content">
            <span class="service-eyebrow">Electrical Repair</span>
            <h1>Safe electrical work with dependable response.</h1>
            <p>Power services for repairs, installations and upgrades handled with care for every home or business.</p>
            <div class="service-actions">
                <a href="#request" class="service-button">Get a free estimate</a>
                <a href="#services" class="service-button service-button--outline">Our services</a>
            </div>
        </div>
    </section>

    <section class="service-main">
        <form class="service-request-form" id="request">
            <input type="hidden" name="service_type" value="Electrical">
            <span class="service-eyebrow">Service Request</span>
            <h2>Submit a Service Request</h2>

            <input type="text" name="num_casa" placeholder="House number" required>
            <input type="text" name="calle" placeholder="Street" required>
            <input type="text" name="ciudad" placeholder="City" required>
            <input type="text" name="estado" placeholder="State (2 letters)" maxlength="2" required>
            <input type="text" name="codigo_postal" placeholder="Zip code" required>
            <input type="text" name="condicion_general" placeholder="General condition of the house" required>
            <textarea name="message" placeholder="Description of the problem" required></textarea>

            <button type="submit">Send request</button>
            <p class="service-form-message" aria-live="polite"></p>
        </form>

        <div class="service-list" id="services">
            <span class="service-eyebrow">Our electrical services</span>
            <h2>Complete electrical solutions</h2>

            <div class="service-cards">
                <article class="service-card">
                    <i class="fa-solid fa-lightbulb"></i>
                    <h3>Lighting installation</h3>
                    <p>Install new lighting fixtures, ceiling lights and lamps.</p>
                </article>
                <article class="service-card">
                    <i class="fa-solid fa-plug-circle-bolt"></i>
                    <h3>Panel repair</h3>
                    <p>Repair or upgrade electrical panels safely and neatly.</p>
                </article>
                <article class="service-card">
                    <i class="fa-solid fa-toggle-on"></i>
                    <h3>Outlet and switch repair</h3>
                    <p>Fix or replace outlets, switches and loose connections.</p>
                </article>
                <article class="service-card">
                    <i class="fa-solid fa-bolt"></i>
                    <h3>Wiring and rewiring</h3>
                    <p>Professional wiring services for homes and renovations.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="service-why">
        <span class="service-eyebrow">Why choose us</span>
        <h2>Trusted electrical repair experts</h2>
    </section>
</main>
