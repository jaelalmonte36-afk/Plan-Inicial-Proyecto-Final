<main class="admin-shell">
    <section class="admin-hero">
        <div>
            <span class="admin-kicker">Financial process</span>
            <h1>Invoices & payments</h1>
            <p>Create client invoices for projects and register payment details against each invoice.</p>
        </div>
        <a class="admin-hero-action" href="/admin/purchases">
            <i class="fa-solid fa-cart-flatbed"></i>
            Materials
        </a>
    </section>

    <section class="process-grid split-forms">
        <form class="process-panel process-form" data-admin-form data-endpoint="/api/admin/invoices">
            <div class="panel-heading">
                <span><i class="fa-solid fa-file-invoice-dollar"></i></span>
                <div>
                    <h2>client invoice</h2>
                    <p>Create an invoice before registering payment.</p>
                </div>
            </div>

            <label>project</label>
            <select name="id_proyecto" required>
                <option value="">select project</option>
                {{#each projects}}
                    <option value="{{id_proyecto}}">
                        project #{{id_proyecto}} - {{cliente}} - {{money monto_acordado}}
                    </option>
                {{/each}}
            </select>

            <div class="compact-fields two-cols">
                <div>
                    <label>subtotal</label>
                    <input name="subtotal" type="number" min="0" step="0.01" required>
                </div>
                <div>
                    <label>tax</label>
                    <input name="impuesto" type="number" min="0" step="0.01" value="0">
                </div>
            </div>

            <p class="process-message" aria-live="polite"></p>

            <div class="process-actions">
                <button class="light-btn" type="reset"><i class="fa-solid fa-plus"></i> new</button>
                <button class="save-btn" type="submit"><i class="fa-regular fa-floppy-disk"></i> save</button>
            </div>
        </form>

        <form class="process-panel process-form" data-admin-form data-endpoint="/api/admin/payments">
            <div class="panel-heading">
                <span><i class="fa-solid fa-money-check-dollar"></i></span>
                <div>
                    <h2>payment registration</h2>
                    <p>Register labor and paid amounts for an invoice.</p>
                </div>
            </div>

            <label>invoice</label>
            <select name="id_factura_cliente" required>
                <option value="">select invoice</option>
                {{#each invoices}}
                    <option value="{{id_factura_cliente}}">
                        #{{id_factura_cliente}} - {{cliente}} - balance {{money balance}}
                    </option>
                {{/each}}
            </select>

            <label>labor price</label>
            <input name="precio_mano_obra" type="number" min="0" step="0.01" required>

            <div class="compact-fields two-cols">
                <div>
                    <label>initial payment</label>
                    <input name="pago_inicial" type="number" min="0" step="0.01" value="0">
                </div>
                <div>
                    <label>final payment</label>
                    <input name="pago_final" type="number" min="0" step="0.01" value="0">
                </div>
            </div>

            <p class="process-message" aria-live="polite"></p>

            <div class="process-actions">
                <button class="light-btn" type="reset"><i class="fa-solid fa-plus"></i> new</button>
                <button class="save-btn" type="submit"><i class="fa-regular fa-floppy-disk"></i> save</button>
                <a class="light-btn danger-link" href="/admin"><i class="fa-solid fa-ban"></i> cancel</a>
            </div>
        </form>
    </section>

    <section class="process-panel process-list">
        <div class="list-header">
            <div>
                <h2>invoice list</h2>
                <p>Created invoices with paid total and balance.</p>
            </div>
            <div class="search-box">
                <label>Search</label>
                <input class="table-search" type="search" data-table="#invoices-table" placeholder="invoice, client, project">
            </div>
        </div>

        <div class="table-wrap">
            <table id="invoices-table">
                <thead>
                    <tr>
                        <th>invoice</th>
                        <th>project</th>
                        <th>client</th>
                        <th>date</th>
                        <th>subtotal</th>
                        <th>tax</th>
                        <th>total</th>
                        <th>paid</th>
                        <th>balance</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each invoices}}
                        <tr>
                            <td>#{{id_factura_cliente}}</td>
                            <td>#{{id_proyecto}}</td>
                            <td>{{cliente}}</td>
                            <td>{{formatDate fecha}}</td>
                            <td>{{money subtotal}}</td>
                            <td>{{money impuesto}}</td>
                            <td>{{money total}}</td>
                            <td>{{money paid_total}}</td>
                            <td>{{money balance}}</td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="9" class="empty-row">No client invoices registered yet.</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </section>

    <section class="process-panel process-list">
        <div class="list-header">
            <div>
                <h2>payment list</h2>
                <p>Payments registered through the payment procedure.</p>
            </div>
            <button class="print-btn" type="button"><i class="fa-solid fa-print"></i> print</button>
        </div>

        <div class="table-wrap">
            <table id="payments-table">
                <thead>
                    <tr>
                        <th>payment</th>
                        <th>invoice</th>
                        <th>client</th>
                        <th>labor</th>
                        <th>initial</th>
                        <th>final</th>
                        <th>total</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each payments}}
                        <tr>
                            <td>#{{id_pago}}</td>
                            <td>#{{id_factura_cliente}}</td>
                            <td>{{cliente}}</td>
                            <td>{{money precio_mano_obra}}</td>
                            <td>{{money pago_inicial}}</td>
                            <td>{{money pago_final}}</td>
                            <td>{{money total}}</td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="empty-row">No payments registered yet.</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </section>
</main>
